# Claude / Anthropic (this suite's default)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional alias; ANTHROPIC_API_KEY is enough
# CLAUDE_API_KEY=

# OpenAI-compatible APIs (only if you switch provider/model away from Claude)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=
# Groq:     https://api.groq.com/openai/v1
# Together: https://api.together.xyz/v1
# Ollama:   http://localhost:11434/v1
